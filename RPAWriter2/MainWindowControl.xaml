<UserControl x:Class="RPAWriter2.MainWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:core="clr-namespace:Agent.Core.Services;assembly=Agent.Core"
             xmlns:corem="clr-namespace:Agent.Core.Models;assembly=Agent.Core"
             xmlns:conv="clr-namespace:RPAWriter2.Converters"
             xmlns:controls="clr-namespace:RPAWriter2.Controls"
             xmlns:toolkit="clr-namespace:Agent.Toolkit.Wpf.Controls;assembly=Agent.Toolkit.Wpf"
             xmlns:sharedconv="clr-namespace:Agent.Toolkit.Wpf.Converters;assembly=Agent.Toolkit.Wpf"
             xmlns:chat="clr-namespace:Agent.Toolkit.Wpf.Controls.Chat;assembly=Agent.Toolkit.Wpf"
             xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
             Background="#2D2D30"
             Foreground="#F1F1F1"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/DarkScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.ErrorText" Color="#F48771"/>
        <SolidColorBrush x:Key="Chat.UserBorder" Color="#CC64B5F6"/>
        <SolidColorBrush x:Key="Chat.UserBackground" Color="#3364B5F6"/>
        <SolidColorBrush x:Key="Commit.SuccessBackground" Color="#2E7D32"/>
        <SolidColorBrush x:Key="Commit.ErrorBackground" Color="#E65100"/>
        <SolidColorBrush x:Key="Chat.LastActBackground" Color="#0D4CAF50"/>
        <SolidColorBrush x:Key="Chat.LastActBorder" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#0DFF8C00"/>
        <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#FF8C00"/>
        <SolidColorBrush x:Key="Mode.PlanBrush" Color="#64B5F6"/>
        <SolidColorBrush x:Key="Mode.ActBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Mode.HelpBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="Deploy.WarningBackground" Color="#E65100"/>
        <SolidColorBrush x:Key="Deploy.SuccessBackground" Color="#B32E7D32"/>
        <SolidColorBrush x:Key="Material.Accent" Color="#64B5F6"/>
        <SolidColorBrush x:Key="Question.OptionBorder" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Question.AnswerBorder" Color="#4CAF50"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Code.Background" Color="#1E1E1E"/>
        <sharedconv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
        <sharedconv:MarkdownToElementConverter x:Key="MarkdownToElement"/>
        <sharedconv:MaterialIconToGeometryConverter x:Key="MaterialIconToGeometry"/>
        <sharedconv:OptionEqualsAnswerConverter x:Key="OptionEqualsAnswerConverter"/>
        <conv:SkipFirstConverter x:Key="SkipFirst"/>
        <conv:CountToVisibilityConverter x:Key="MultiProviderVisibility"/>
        <conv:AgentModeToToggleValueConverter x:Key="ModeToToggle"/>
        <conv:EnumMatchConverter x:Key="PhaseStreamingVisibility" Match="Streaming"
                                 WhenMatch="Visible" WhenDifferent="Collapsed"/>
        <conv:EnumMatchConverter x:Key="PhaseErrorVisibility" Match="Error"
                                 WhenMatch="Visible" WhenDifferent="Collapsed"/>
        <conv:EnumMatchConverter x:Key="PhaseNotStreaming" Match="Streaming"
                                 WhenMatch="False" WhenDifferent="True"/>
        <conv:AllTrueMultiConverter x:Key="AllTrue"/>
        <chat:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"/>

        <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
        </Style>

        <DataTemplate DataType="{x:Type core:TextMessageBlock}">
            <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource Dark.ErrorText}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
            <Border Background="{StaticResource Code.Background}" BorderBrush="{StaticResource Dark.Border}"
                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{StaticResource Dark.Text}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="{StaticResource Dark.Text}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"
                                                      Width="8" Height="4"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Dark.Control}"
                                        BorderBrush="{StaticResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Dark.Control}"
                                        BorderBrush="{StaticResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Path Data="M 0,0 L 4,4 L 8,0 Z"
                                                  Fill="{StaticResource Dark.Text}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Width="8" Height="4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{StaticResource Dark.Text}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{StaticResource Dark.Accent}"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource Dark.Control}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Dark.ControlHover}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Accent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInputActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="2,2,0,0" Padding="14,6" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Panel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MessageSampleTemplate">
            <StackPanel Margin="0,0,0,10">
                <Border Background="Transparent" BorderBrush="{Binding Accent}" BorderThickness="{Binding BorderThickness}" CornerRadius="2" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Copy" Click="OnCopyMessageSample"
                                Visibility="{Binding ShowCopy, Converter={StaticResource BoolToVis}}">
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Fill="{Binding Foreground}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Add to chat input" Click="OnSendMessageSample"
                                Visibility="{Binding ShowSend, Converter={StaticResource BoolToVis}}">
                            <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                  Fill="{Binding Foreground}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Close"
                                Visibility="{Binding ShowClose, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✕" FontSize="12" Foreground="{Binding Foreground}"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Material.Accent}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="AccentHighlight" Background="{StaticResource Material.Accent}" Opacity="0"/>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentHighlight" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabIconOutlineStyle" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{StaticResource Material.Accent}"/>
        </Style>

        <Style x:Key="MainTabIconFilledStyle" TargetType="Path" BasedOn="{StaticResource MainTabIconOutlineStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl x:Name="MainTabs" Margin="8,8,8,5">
        <TabItem Style="{StaticResource MainTabItemStyle}" Tag="Chat" ToolTip="Chat">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.MessageOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.Message}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <toolkit:ChatControl x:Name="ChatPanel" />
        </TabItem>
        <TabItem x:Name="SettingsTab" Style="{StaticResource MainTabItemStyle}" Tag="Settings" ToolTip="Settings">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.CogOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.Cog}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <toolkit:SettingsControl x:Name="SettingsPanel" />
        </TabItem>
        <TabItem x:Name="SpecTab" Style="{StaticResource MainTabItemStyle}" Tag="Spec" ToolTip="Spec">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.FileDocumentOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.FileDocument}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Deploy" Click="OnDeploy" Margin="0,5,8,0"/>
                    <Button Content="Analyze logs" Click="OnAnalyzeLogs" Margin="0,5,8,0"/>
                    <Button Content="Import spec" Command="{Binding Cmd}" CommandParameter="ImportSpecCommand" Margin="0,5,8,0"/>
                    <Button Content="Generate algorithm" Command="{Binding Cmd}" CommandParameter="GenerateAlgorithmCommand" Margin="0,5,8,0"/>
                    <Button Content="Generate robot" Command="{Binding Cmd}" CommandParameter="GenerateRobotCommand" Margin="0,5,8,0"/>
                    <Button Content="Find similar" Command="{Binding Cmd}" CommandParameter="FindSimilarCommand" Margin="0,5,8,0"/>
                    <Button Content="Robot security audit" Command="{Binding Cmd}" CommandParameter="SecurityAuditCommand" Margin="0,5,8,0"/>
                    <Button Content="Convert md to docx" Command="{Binding Cmd}" CommandParameter="ConvertMarkdownToDocxCommand" Margin="0,5,8,0"/>
                    <Button Content="Clear" Command="{Binding Cmd}" CommandParameter="ClearSpecCommand" Margin="0,5,8,0"/>
                </WrapPanel>
                <controls:NotificationBanner x:Name="NoticeBar" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed"
                                              CloseRequested="OnNoticeClose"
                                              SendToChatRequested="OnNotificationSendToChat"/>
                <controls:NotificationBanner x:Name="DeployToast" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed"
                                              CloseRequested="OnDeployToastClose"
                                              SendToChatRequested="OnNotificationSendToChat"/>
                <Border x:Name="ImportProgressPanel" DockPanel.Dock="Top" Background="{StaticResource Dark.Panel}"
                        BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"
                        Padding="10,6" Margin="0,0,0,8" Visibility="{Binding Spec.IsImporting, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock x:Name="ImportStatusText" Foreground="{StaticResource Dark.Text}" TextWrapping="Wrap"
                                   Text="{Binding Spec.ImportStatus, Mode=OneWay}"/>
                        <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                                     Foreground="{StaticResource Dark.Accent}"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="CopySpecAllButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,0,4"
                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                            ToolTip="Copy all" Click="OnCopySpecOutput" Visibility="{Binding Spec.HasOutput, Converter={StaticResource BoolToVis}}">
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                    <toolkit:ChatMessagesControl x:Name="SpecMessages" Grid.Row="1"/>
                    <Grid x:Name="AnalyzeLogsPanel" Grid.Row="0" Grid.RowSpan="2"
                          Background="{StaticResource Dark.Window}" Visibility="Collapsed">
                        <Border Margin="8"
                                Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                                BorderThickness="1" CornerRadius="2" Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Log source:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                                VerticalAlignment="Top" ToolTip="Close" Click="OnCloseAnalyzeLogs">
                                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="From Visual Studio Output window" Click="OnAnalyzeLogsFromOutputWindow" Margin="0,0,8,0"/>
                                        <Button Content="From production servers" Click="OnAnalyzeLogsFromProdServers"/>
                                    </StackPanel>
    
                                    <Grid Grid.Row="2" x:Name="ProdLogsPanel" Margin="0,6,0,0" Visibility="Collapsed"
                                          DataContext="{Binding Chat.LogAnalyzer}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="80"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="80"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
    
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Min level:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="MinLevelCombo" Width="110" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      ItemsSource="{Binding MinLevelOptions}" DisplayMemberPath="Title"
                                                      SelectedItem="{Binding SelectedMinLevel, Mode=TwoWay}"
                                                      SelectionChanged="OnMinLevelChanged"/>
                                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <DatePicker x:Name="FromDatePicker" Width="130" VerticalAlignment="Center" Margin="0,0,12,0" SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                                        SelectedDateChanged="OnDateRangeChanged"/>
                                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <DatePicker x:Name="ToDatePicker" Width="130" VerticalAlignment="Center" SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                                        SelectedDateChanged="OnDateRangeChanged"/>
                                        </StackPanel>
    
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Robot name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="RobotNameBox" Width="160" VerticalAlignment="Center" Margin="0,0,8,0" ItemsSource="{Binding RobotNameSuggestions}" Text="{Binding RobotName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" Style="{StaticResource EditableComboBoxStyle}"
                                                      KeyDown="OnRobotNameKeyDown"/>
                                            <Button Content="Load tasks" Click="OnLoadProdTasks" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ProviderCombo" Width="200" Margin="12,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                      Visibility="{Binding Providers.Count, Converter={StaticResource MultiProviderVisibility}}"/>
                                        </StackPanel>
    
                                        <TextBlock Grid.Row="2" x:Name="ProdLogsStatusText" Text="{Binding StatusText}" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,0,0,4"/>
    
                                        <TextBlock Grid.Row="3" Text="Tasks:" Foreground="#C8C8C8" Margin="0,0,0,2"/>
                                        <DataGrid Grid.Row="4" x:Name="TasksGrid" AutoGenerateColumns="True" IsReadOnly="True" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                                  SelectionMode="Single" SelectionChanged="OnTaskSelected"
                                                  CanUserAddRows="False"/>
    
                                        <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                                      Background="{StaticResource Dark.Border}"/>
                                        <TextBlock Grid.Row="6" Text="Logs:" Foreground="#C8C8C8" Margin="0,0,0,2"/>
                                        <DataGrid Grid.Row="7" x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Logs}"
                                                  SelectionMode="Single" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="Auto"/>
                                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                                <DataGridTemplateColumn Header="Parameters" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock x:Name="SingleParameterText" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Dark.Text}"
                                                                           Visibility="Collapsed">
                                                                    <Run Text="{Binding Parameters[0].Key, Mode=OneWay}"/><Run Text=" = "/><Run Text="{Binding Parameters[0].Value, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <ToggleButton x:Name="ParametersToggle" Focusable="False" HorizontalAlignment="Left"
                                                                              Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                                              Foreground="{StaticResource Dark.Text}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent">
                                                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                                                            <Polyline x:Name="Chevron" Points="6,9 12,15 18,9"
                                                                                      Stroke="{StaticResource Dark.Text}" StrokeThickness="2"
                                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                      Fill="Transparent"/>
                                                                        </Viewbox>
                                                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Dark.Text}">
                                                                            <Run Text="{Binding Parameters[0].Key, Mode=OneWay}"/><Run Text=" = "/><Run Text="{Binding Parameters[0].Value, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <ItemsControl x:Name="AllParametersList" ItemsSource="{Binding Parameters, Converter={StaticResource SkipFirst}}" Margin="0,2,0,0"
                                                                              Visibility="Collapsed">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Foreground="{StaticResource Dark.Text}">
                                                                                <Run Text="{Binding Key, Mode=OneWay}"/><Run Text=" = "/><Run Text="{Binding Value, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ParametersToggle}" Value="True">
                                                                    <Setter TargetName="AllParametersList" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="Chevron" Property="Points" Value="6,15 12,9 18,15"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Parameters.Count}" Value="0">
                                                                    <Setter TargetName="ParametersToggle" Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Parameters.Count}" Value="1">
                                                                    <Setter TargetName="ParametersToggle" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="SingleParameterText" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
    
                                        <Button Grid.Row="8" Content="Analyze logs" Click="OnAnalyzeProdLogs" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0"/>
                                    </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="KnowledgeBaseTab" Style="{StaticResource MainTabItemStyle}" Tag="KnowledgeBase" ToolTip="Knowledge base">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.DatabaseOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.Database}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="64"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <ComboBox x:Name="KbModeCombo" SelectedIndex="{Binding KnowledgeBase.ImportModeIndex, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,5,8,0">
                        <ComboBoxItem Content="Override (start over)"/>
                        <ComboBoxItem Content="Continue (resume)"/>
                    </ComboBox>
                    <Button x:Name="KbImportButton" Content="Import from robots" Command="{Binding Cmd}" CommandParameter="ImportFromRobotsCommand" IsEnabled="{Binding KnowledgeBase.CanImport, Mode=OneWay}" Margin="0,5,8,0"/>
                    <Button x:Name="KbPauseButton" Content="{Binding KnowledgeBase.PauseButtonText, Mode=OneWay}" Command="{Binding Cmd}" CommandParameter="PauseCommand" IsEnabled="{Binding KnowledgeBase.IsImporting, Mode=OneWay}" Margin="0,5,8,0"/>
                    <Button x:Name="KbStopButton" Content="Stop" Command="{Binding Cmd}" CommandParameter="StopCommand" IsEnabled="{Binding KnowledgeBase.IsImporting, Mode=OneWay}" Margin="0,5,8,0"/>
                    <Button Content="Refresh" Command="{Binding Cmd}" CommandParameter="RefreshCommand" Margin="0,5,8,0"/>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="KbStatusText" IsReadOnly="True"
                             Height="80" MaxLines="3"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Foreground="#C8C8C8"
                             Text="{Binding KnowledgeBase.StatusText, Mode=OneWay}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <ProgressBar Grid.Row="1" x:Name="KbProgressBar" Height="6" Margin="0,4,0,0"
                                 Minimum="0" Maximum="100" Value="{Binding KnowledgeBase.Progress, Mode=OneWay}"
                                 Foreground="{StaticResource Dark.Accent}" Visibility="{Binding KnowledgeBase.IsImporting, Converter={StaticResource BoolToVis}}"/>

                </Grid>

                <Grid Grid.Row="2" Margin="0,4,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Messages:" VerticalAlignment="Center" Foreground="#C8C8C8"/>
                        <CheckBox x:Name="KbAutoScrollCheckBox" Content="Auto-scroll" IsChecked="{Binding KnowledgeBase.AutoScroll, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="KbMessagesBox" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding KnowledgeBase.MessagesText, Mode=OneWay}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>

            </Grid>
        </TabItem>

        <TabItem x:Name="PackagesTab" Style="{StaticResource MainTabItemStyle}" Tag="Packages" ToolTip="Packages">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.PackageOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.Package}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="Refresh" Click="OnRefreshPackages" Margin="0,5,8,0"/>
                    <Button Content="Install selected" Click="OnInstallSelectedPackages" Margin="0,5,8,0"/>
                    <Button Content="Update selected" Click="OnUpdateSelectedPackages" Margin="0,5,8,0"/>
                    <Button Content="Uninstall selected" Click="OnUninstallSelectedPackages" Margin="0,5,8,0"/>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="16,5,6,0"/>
                    <TextBox x:Name="PackageFilterBox" Text="Activities." Width="180"
                             TextChanged="OnPackageFilterChanged" VerticalContentAlignment="Center"
                             ToolTip="Show packages whose name starts with this value" Margin="0,5,0,0"/>
                </WrapPanel>

                <TextBlock Grid.Row="1" x:Name="PackagesStatusText" Foreground="#C8C8C8"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                <ListView Grid.Row="2" x:Name="PackagesList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" Margin="8,0,0,0"
                                               Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                              Width="120" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding InstalledBadge}" Margin="8,0,0,0" Foreground="#7AC88F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Margin="24,2,0,0" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="RestorePackagesPanel" Grid.Row="3"
                        Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Restore packages" Click="OnRestorePackages" VerticalAlignment="Center"/>
                        <TextBlock Text="Update-Package -Reinstall for the current solution" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem x:Name="ControlsTab" Style="{StaticResource MainTabItemStyle}" Tag="Controls" ToolTip="Controls" Visibility="Collapsed">
            <TabItem.Header>
                <Grid>
                    <Path Style="{StaticResource MainTabIconOutlineStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.PaletteOutline}, Converter={StaticResource MaterialIconToGeometry}}"/>
                    <Path Style="{StaticResource MainTabIconFilledStyle}"
                          Data="{Binding Source={x:Static mi:MaterialIconKind.Palette}, Converter={StaticResource MaterialIconToGeometry}}"/>
                </Grid>
            </TabItem.Header>
            <TabControl x:Name="ControlsInnerTabs" Margin="4">
                <TabItem x:Name="NotificationsTab" Header="Notifications">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Auto-hide (s) — 0 = never" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="NotificationAutoHideBox" Text="5" Width="60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="ReplayNotificationsButton" Content="Replay" Click="OnReplayNotifications" VerticalAlignment="Center" Padding="8,2"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ControlsMessagesList" ItemTemplate="{StaticResource MessageSampleTemplate}" Margin="8"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Chat">
                    <ListBox x:Name="ControlsChatList"
                             Background="{StaticResource Dark.Panel}"
                             BorderThickness="0"
                             Margin="8"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="2,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </TabItem>
                <TabItem Header="SVG">
                    <DockPanel Margin="8">
                        <TextBox x:Name="SvgSearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                                 TextChanged="OnSvgSearchTextChanged"
                                 ToolTip="Search icons by identifier"/>
                        <ListBox x:Name="ControlsSvgList"
                                 Background="{StaticResource Dark.Panel}"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLength="2,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ChildSize="112,108"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="104" Background="{StaticResource Dark.Control}"
                                            BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                                            CornerRadius="2" Padding="8">
                                        <StackPanel>
                                            <Path Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                  Fill="{StaticResource Dark.Text}"
                                                  Data="{Binding Kind, Converter={StaticResource MaterialIconToGeometry}}"/>
                                            <TextBlock Text="{Binding Identifier}" Margin="0,6,0,0" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Identifier}"
                                                       FontSize="10" Foreground="{StaticResource Dark.Text}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                <Button Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                        Margin="0,0,4,0" ToolTip="Copy identifier"
                                                        Click="OnCopySvgIdentifier">
                                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                          Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                        Margin="4,0,0,0" ToolTip="Add to chat input"
                                                        Click="OnSendSvgIdentifier">
                                                    <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                                          Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Palette">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ControlsPaletteList" Margin="8">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,4" Foreground="#C8C8C8"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="22" Background="{Binding Brush}"
                                                BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{StaticResource Dark.Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Hex}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontFamily="Consolas" Foreground="#C8C8C8"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </TabItem>

    </TabControl>
</UserControl>
