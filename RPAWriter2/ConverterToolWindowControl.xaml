<UserControl x:Class="RPAWriter2.ConverterToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RPAWriter2.Controls"
             Background="#2D2D30"
             Foreground="#F1F1F1">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/DarkScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Self-contained dark theme brushes (kept local so the window does not depend on the host's resources). -->
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="PixRobotConversionRow" Height="0"/>
            <RowDefinition x:Name="PixMwfMapRow" Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="UiPath → MWF" Click="OnConvertUiPath" Margin="0,5,8,0"/>
            <Button Content="Convert PIX to MWF" Click="OnConvertPix" Margin="0,5,8,0"/>
            <Button Content="Parse All Activities From PIX" Click="OnParseAllActivitiesFromPix" Margin="0,5,8,0"/>
            <Button Content="Import PIX activities (rewrite library)" Click="OnImportPixActivities" Margin="0,5,8,0"/>
            <Button Content="Get All MWF Activities" Click="OnGetAllMwfActivities" Margin="0,5,8,0"/>
            <Button Content="View WF snippets" Click="OnViewWfSnippets" Margin="0,5,8,0"/>
            <Button Content="Get System Activities" Click="OnGetSystemActivities" Margin="0,5,8,0"/>
            <Button Content="Select System Activities" Click="OnSelectSystemActivities" Margin="0,5,8,0"/>
            <Button Content="PIX to MWF map" Click="OnOpenPixMwfMap" Margin="0,5,8,0"/>
            <Button Content="Clear" Click="OnClearConverter" Margin="0,5,8,0"/>
        </WrapPanel>
        <Border x:Name="PixRobotConversionHost" Grid.Row="1" Margin="0,0,0,8"
                BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"
                Background="{StaticResource Dark.Panel}" Padding="8,6" Visibility="Collapsed">
            <controls:PixRobotConversionControl x:Name="PixRobotConversionPanel"/>
        </Border>
        <Border x:Name="PixMwfMapHost" Grid.Row="2" Margin="0,0,0,8"
                BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"
                Background="{StaticResource Dark.Panel}" Padding="8,6" Visibility="Collapsed">
            <controls:PixMwfMappingControl x:Name="PixMwfMapControl"/>
        </Border>
        <GridSplitter x:Name="PixMwfMapSplitter" Grid.Row="3" Height="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource Dark.Border}"
                      Visibility="Collapsed"/>
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="CopyConverterAllButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,0,4"
                    Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                    ToolTip="Copy all" Click="OnCopyConverterOutput" Visibility="Collapsed">
                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18"/>
            </Button>
            <controls:ChatMessagesControl x:Name="ConverterMessages" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
