<UserControl x:Class="RPAWriter2.Controls.ContextIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid x:Name="FillTrack" Height="4">
            <Border Background="#33FFFFFF"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CacheHitColumn" Width="0*"/>
                    <ColumnDefinition x:Name="MissColumn" Width="0*"/>
                    <ColumnDefinition x:Name="RemainderColumn" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="CacheHitSegment" Grid.Column="0" Background="#A5D6A7"/>
                <Border x:Name="MissSegment" Grid.Column="1" Background="#6E6E6E"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="FillText" Margin="0,4,0,0" Foreground="#C8C8C8"
                   Text="Context window: —"/>
        <TextBlock x:Name="CacheText" Margin="0,2,0,0" Foreground="#9A9A9A"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="StatsText" Margin="0,2,0,0" Foreground="#9A9A9A"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
