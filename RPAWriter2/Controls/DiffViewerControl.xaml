<UserControl x:Class="RPAWriter2.Controls.DiffViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RPAWriter.Core.Checkpoints;assembly=RPAWriter.Core"
             Background="#2D2D30"
             Foreground="#F1F1F1">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/DarkScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Diff.AddBackground" Color="#334CAF50"/>
            <SolidColorBrush x:Key="Diff.RemoveBackground" Color="#33F44336"/>
            <SolidColorBrush x:Key="Diff.ModifiedBackground" Color="#33FF8C00"/>
            <SolidColorBrush x:Key="Diff.LineNumber" Color="#8A8A8A"/>
            <SolidColorBrush x:Key="Diff.Header" Color="#C8C8C8"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title, summary and view-mode switch. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{StaticResource Diff.Header}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Margin="12,0,0,0" Foreground="{StaticResource Diff.LineNumber}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="SideBySideToggle" Content="Side by side" IsChecked="True" Checked="OnViewModeChanged" Foreground="{StaticResource Diff.Header}" VerticalAlignment="Center"/>
                <RadioButton x:Name="InlineToggle" Content="Inline" Margin="12,0,0,0" Checked="OnViewModeChanged" Foreground="{StaticResource Diff.Header}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Body: file list on the left, diff on the right. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="0,0,1,0" Margin="5,5,8,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Changed files" Foreground="{StaticResource Diff.Header}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="FilesList" Grid.Row="1" SelectionChanged="OnFileSelected"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Diff.Header}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RelativePath}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangeSummary}" Foreground="{StaticResource Diff.LineNumber}" FontFamily="Consolas"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="EmptyText" Grid.Row="0" Grid.RowSpan="2" Text="(no changes)"
                           Foreground="{StaticResource Diff.LineNumber}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="SideBySideHeader" Grid.Row="0" Margin="0,0,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Before" FontWeight="SemiBold" Foreground="{StaticResource Diff.Header}" Margin="6,0" MinWidth="28"/>
                    <TextBlock Grid.Column="2" Text="After" FontWeight="SemiBold" Foreground="{StaticResource Diff.Header}" Margin="6,0" MinWidth="28"/>
                </Grid>

                <ScrollViewer x:Name="SideBySideScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="SideBySideList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffBeforeNumber"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffBeforeText"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffAfterNumber"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffAfterText"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LeftNumber}" Foreground="{StaticResource Diff.LineNumber}" FontFamily="Consolas" FontSize="12" Margin="6,0" TextAlignment="Right" MinWidth="28"/>
                                    <Border Grid.Column="1" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Deleted}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.RemoveBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Modified}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.ModifiedBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LeftText}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Padding="4,0"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding RightNumber}" Foreground="{StaticResource Diff.LineNumber}" FontFamily="Consolas" FontSize="12" Margin="6,0" TextAlignment="Right" MinWidth="28"/>
                                    <Border Grid.Column="3" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Inserted}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.AddBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Modified}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.ModifiedBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RightText}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Padding="4,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="InlineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="InlineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffInlinePrefix"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiffInlineText"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Prefix}" Foreground="{StaticResource Diff.LineNumber}" FontFamily="Consolas" FontSize="12" Margin="6,0" MinWidth="28"/>
                                    <Border Grid.Column="1" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Inserted}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.AddBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffRowKind.Deleted}">
                                                        <Setter Property="Background" Value="{StaticResource Diff.RemoveBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Padding="4,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
