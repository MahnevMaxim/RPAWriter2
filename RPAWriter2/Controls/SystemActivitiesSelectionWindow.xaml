<Window x:Class="RPAWriter2.Controls.SystemActivitiesSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select System Activities"
        Width="560" Height="620"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30" Foreground="#F1F1F1">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/DarkScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Self-contained dark theme brushes (kept local so the dialog does not depend on the host's resources). -->
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Select which built-in Workflow Foundation (System.Activities) activities to import. Run &quot;Get System Activities&quot; first if the list is empty."/>

        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,8"
                 ToolTip="Filter activities by display name or full name"
                 TextChanged="OnSearchTextChanged"/>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="CountHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="#C8C8C8" Text=""/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Select All" Click="OnSelectAll" Margin="0,0,8,0"/>
                <Button Content="Clear All" Click="OnClearAll"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="ActivityList" Grid.Row="3"
                 Background="{StaticResource Dark.Panel}"
                 BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                 Padding="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Top" Margin="2">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FullName}" FontFamily="Consolas" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Click="OnOk" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="OnCancel" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>

