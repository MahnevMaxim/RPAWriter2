<Window x:Class="RPAWriter2.Controls.WfSnippetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WF Snippets"
        Width="860" Height="560"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30" Foreground="#F1F1F1">
    <Window.Resources>
        <!-- Self-contained dark theme brushes (kept local so the dialog does not depend on the host's resources). -->
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Workflow Foundation activity snippets deployed in ActivityLibrary/wf (XAML templates with {{placeholder}} markers)."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SnippetList" Grid.Column="0" Margin="0,0,8,0"
                     Background="{StaticResource Dark.Panel}"
                     BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                     Padding="4"
                     SelectionChanged="OnSelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <TextBox x:Name="SnippetContent" Grid.Column="1"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource Dark.Panel}"
                     Foreground="{StaticResource Dark.Text}"
                     BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                     Padding="6"/>
        </Grid>
    </Grid>
</Window>
