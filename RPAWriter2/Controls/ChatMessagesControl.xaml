<UserControl x:Class="RPAWriter2.Controls.ChatMessagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RPAWriter.Core.Services;assembly=RPAWriter.Core"
             xmlns:conv="clr-namespace:RPAWriter2.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Block rendering stays host-local: the code-scroll style needs a code-behind
                 handler, and the implicit templates resolve against this control's resources. -->
            <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
            <conv:MermaidCodeToElementConverter x:Key="MermaidCodeToElement"/>

            <Style x:Key="CodeScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="#2E2E30"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                      Style="{StaticResource ScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                      Style="{StaticResource ScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="CodeScrollViewerTemplate" TargetType="ScrollViewer">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                            Margin="{TemplateBinding Padding}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1"
                               Orientation="Horizontal"
                               Style="{StaticResource CodeScrollBarStyle}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Bottom"
                               ViewportSize="{TemplateBinding ViewportWidth}"
                               Minimum="0"
                               Maximum="{TemplateBinding ScrollableWidth}"
                               Value="{TemplateBinding HorizontalOffset}"
                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                               Cursor="Arrow"/>
                </Grid>
            </ControlTemplate>

            <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
                <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
                <Setter Property="Template" Value="{StaticResource CodeScrollViewerTemplate}"/>
            </Style>

            <DataTemplate DataType="{x:Type core:TextMessageBlock}">
                <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource Dark.ErrorText}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DataTemplate>

            <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
                <Grid>
                    <Border x:Name="CodeBorder" Background="{StaticResource Code.Background}" BorderBrush="{StaticResource Dark.Border}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                        <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                        </ScrollViewer>
                    </Border>
                    <ContentControl x:Name="MermaidHost" Visibility="Collapsed"
                                    Content="{Binding Code, Mode=OneWay, Converter={StaticResource MermaidCodeToElement}}"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMermaid}" Value="True">
                        <Setter TargetName="CodeBorder" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="MermaidHost" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="ChatScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnChatScrollChanged">
        <ItemsControl x:Name="ChatList" ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"/>
    </ScrollViewer>
</UserControl>
