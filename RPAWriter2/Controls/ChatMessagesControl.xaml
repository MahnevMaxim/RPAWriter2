<UserControl x:Class="RPAWriter2.Controls.ChatMessagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RPAWriter.Core.Services;assembly=RPAWriter.Core"
             xmlns:conv="clr-namespace:RPAWriter2.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Block rendering stays host-local: the code-scroll style needs a code-behind
                 handler, and the implicit templates resolve against this control's resources. -->
            <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
            <conv:MermaidCodeToElementConverter x:Key="MermaidCodeToElement"/>

            <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
                <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
            </Style>

            <DataTemplate DataType="{x:Type core:TextMessageBlock}">
                <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource Dark.ErrorText}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DataTemplate>

            <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
                <Grid>
                    <Border x:Name="CodeBorder" Background="{StaticResource Code.Background}" BorderBrush="{StaticResource Dark.Border}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                        <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                        </ScrollViewer>
                    </Border>
                    <ContentControl x:Name="MermaidHost" Visibility="Collapsed"
                                    Content="{Binding Code, Mode=OneWay, Converter={StaticResource MermaidCodeToElement}}"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMermaid}" Value="True">
                        <Setter TargetName="CodeBorder" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="MermaidHost" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="ChatScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnChatScrollChanged">
        <ItemsControl x:Name="ChatList" ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"/>
    </ScrollViewer>
</UserControl>
