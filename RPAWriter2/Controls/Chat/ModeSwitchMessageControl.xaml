<UserControl x:Class="RPAWriter2.Controls.Chat.ModeSwitchMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:RPAWriter2.Controls.Chat">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Margin="8,4,0,7">
        <TextBlock Text="Mode: " Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Mode, Mode=OneWay}" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="Act">
                            <Setter Property="Foreground" Value="{StaticResource Mode.ActBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode}" Value="Plan">
                            <Setter Property="Foreground" Value="{StaticResource Mode.PlanBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode}" Value="Help">
                            <Setter Property="Foreground" Value="{StaticResource Mode.HelpBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
