<UserControl x:Class="RPAWriter2.Controls.Chat.CompactionMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
               Foreground="{StaticResource Dark.Text}" Margin="8,4,0,7" VerticalAlignment="Center"/>
</UserControl>