<UserControl x:Class="RPAWriter2.Controls.Chat.DiffMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
        <TextBlock Text="diff" Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
        <Button Click="OnOpenDiff"
                Style="{StaticResource IconButtonStyle}"
                Padding="0"
                Margin="8,0,0,0"
                ToolTip="Open iteration diff">
            <TextBlock Text="{Binding Payload.ShortHash}" Foreground="#4CAF50" FontFamily="Consolas" VerticalAlignment="Center"/>
        </Button>
    </StackPanel>
</UserControl>
