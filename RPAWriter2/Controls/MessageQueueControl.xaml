<UserControl x:Class="RPAWriter2.Controls.MessageQueueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RPAWriter2.Converters"
             xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Resources not provided by ChatResources.xaml, kept local so the control stays self-contained. -->
            <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>

            <conv:MaterialIconToGeometryConverter x:Key="MaterialIconToGeometry"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Visibility is managed from code-behind (UpdateVisibility). -->
    <Border Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
            BorderThickness="1" CornerRadius="2" Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- list -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueuedLabel" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource Dark.Text}"/>
                <Button Grid.Column="1" Width="22" Height="22" Click="OnClearAll"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Clear all">
                    <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Broom}, Converter={StaticResource MaterialIconToGeometry}}"
                          Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- List -->
            <ItemsControl Grid.Row="1" x:Name="QueueList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- steer toggle -->
                                <ColumnDefinition Width="*"/>    <!-- editable text -->
                                <ColumnDefinition Width="Auto"/> <!-- attachments -->
                                <ColumnDefinition Width="Auto"/> <!-- up -->
                                <ColumnDefinition Width="Auto"/> <!-- down -->
                                <ColumnDefinition Width="Auto"/> <!-- delete -->
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" ToolTip="{Binding DeliveryToolTip, Mode=OneWay}"
                                    Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                    Margin="0,0,4,0" Click="OnToggleDelivery">
                                <Path Data="{Binding DeliveryIcon, Mode=OneWay, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>

                            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalAlignment="Center" TextWrapping="NoWrap"
                                     Foreground="{StaticResource Dark.Text}" CaretBrush="{StaticResource Dark.Text}"/>

                            <TextBlock Grid.Column="2" Text="{Binding AttachmentSummary, Mode=OneWay}"
                                       VerticalAlignment="Center" Margin="6,0,4,0"
                                       Foreground="{StaticResource Dark.Text}"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>

                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Margin="0,0,2,0" Click="OnMoveUp" ToolTip="Move up">
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ChevronUp}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Margin="0,0,2,0" Click="OnMoveDown" ToolTip="Move down">
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ChevronDown}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Click="OnDelete" ToolTip="Remove from queue">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
