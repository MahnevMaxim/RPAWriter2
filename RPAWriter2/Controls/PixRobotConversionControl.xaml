<UserControl x:Class="RPAWriter2.Controls.PixRobotConversionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Self-contained dark theme brushes (kept local so the control does not depend on the host's resources). -->
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Dark.Window}">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" Margin="8,0,0,0"/>
                <Button x:Name="StartButton" Content="Start conversion" Click="OnStart" MinWidth="120"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PIX robot folder:" Margin="0,0,8,6"/>
            <TextBox x:Name="PixFolderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"/>
            <Button x:Name="PixBrowseButton" Grid.Row="0" Grid.Column="2" Content="Browse…" Click="OnBrowsePixFolder" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="MWF target folder:" Margin="0,0,8,0"/>
            <TextBox x:Name="MwfFolderBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"/>
            <Button x:Name="MwfBrowseButton" Grid.Row="1" Grid.Column="2" Content="Browse…" Click="OnBrowseMwfFolder"/>
        </Grid>
    </DockPanel>
</UserControl>
