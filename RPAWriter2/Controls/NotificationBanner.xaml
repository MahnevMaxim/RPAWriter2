<UserControl x:Class="RPAWriter2.Controls.NotificationBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="Transparent"
            BorderBrush="{Binding AccentBrush, ElementName=Root}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Message, ElementName=Root}"
                       Foreground="{Binding AccentBrush, ElementName=Root}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                    VerticalAlignment="Center" ToolTip="Copy" Click="OnCopyClick"
                    Visibility="{Binding ShowCopy, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                      Fill="{Binding AccentBrush, ElementName=Root}" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                    VerticalAlignment="Center" ToolTip="Send to chat" Click="OnSendClick"
                    Visibility="{Binding ShowSend, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                      Fill="{Binding AccentBrush, ElementName=Root}" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                    VerticalAlignment="Center" ToolTip="Close" Click="OnCloseClick"
                    Visibility="{Binding ShowClose, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="✕" FontSize="12" Foreground="{Binding AccentBrush, ElementName=Root}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
