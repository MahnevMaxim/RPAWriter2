<UserControl x:Class="RPAWriter2.Controls.CreateRobotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/AgentTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Root"
            Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1" CornerRadius="2" Padding="8,6" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Robot number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="RobotNumberBox" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                     PreviewTextInput="OnRobotNumberPreviewTextInput"/>
            <Button Content="Create robot" Click="OnCreateClick" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
