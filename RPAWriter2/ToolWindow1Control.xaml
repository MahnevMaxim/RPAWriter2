<UserControl x:Class="RPAWriter2.ToolWindow1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:core="clr-namespace:RPAWriter.Core.Services;assembly=RPAWriter.Core"
             xmlns:conv="clr-namespace:RPAWriter2.Converters"
             Background="#2D2D30"
             Foreground="#F1F1F1"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.ErrorText" Color="#F48771"/>
        <SolidColorBrush x:Key="Chat.UserBorder" Color="#CC64B5F6"/>
        <SolidColorBrush x:Key="Chat.UserBackground" Color="#3364B5F6"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Code.Background" Color="#1E1E1E"/>
        <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>

        <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
        </Style>

        <DataTemplate DataType="{x:Type core:TextMessageBlock}">
            <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource Dark.ErrorText}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
            <Border Background="{StaticResource Code.Background}" BorderBrush="{StaticResource Dark.Border}"
                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{StaticResource Dark.Text}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="{StaticResource Dark.Text}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"
                                                      Width="8" Height="4"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Dark.Control}"
                                        BorderBrush="{StaticResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="2,2,0,0" Padding="14,6" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Panel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MessageTemplate">
            <Border Background="{StaticResource Dark.Panel}" CornerRadius="2" Padding="8,6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Expander Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                                  Foreground="{StaticResource Dark.Text}"
                                  Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Reasoning, Mode=OneWay}" TextWrapping="Wrap"
                                     Foreground="#C8C8C8" FontStyle="Italic"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding Blocks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}" Width="16" Height="16"
                            ToolTip="Copy message" Click="OnCopyMessage">
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <TabControl x:Name="MainTabs" Margin="8">
        <TabItem Header="Chat">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="60"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <WrapPanel Margin="0,5,0,6">
                        <Button Content="New chat" Click="OnNewChat" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HistoryCombo" Width="220" VerticalAlignment="Center" Margin="0,0,4,0"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectionChanged="OnHistorySelectionChanged"
                                  ToolTip="Chat history"/>
                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                ToolTip="Delete current chat" Click="OnDeleteChat" Margin="0,0,8,0">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource Dark.Text}"/>
                        </Button>
                        <Button Content="commit" Click="OnCommit" Margin="0,0,8,0"/>
                        <Button Content="deploy" Click="OnBuildRelease" Margin="0,0,8,0"/>
                        <Button Content="generate robot" Click="OnGenerateRobot" Margin="0,0,8,0"/>
                        <Button Content="Analyze logs" Click="OnAnalyzeLogs" Margin="0,0,8,0"/>
                        <Button Content="send errors" Click="OnSendErrors" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                ToolTip="Copy conversation" Click="OnCopyConversation" Margin="0,0,8,0">
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                    </WrapPanel>
                    <Border x:Name="CreateRobotPanel" Margin="0,0,0,6"
                            Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Robot number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RobotNumberBox" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                                     PreviewTextInput="OnRobotNumberPreviewTextInput"/>
                            <Button Content="Create robot" Click="OnCreateRobot" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="1" x:Name="ChatScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ChatList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2" Padding="8,6" Margin="0,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KindName}" Value="User">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Chat.UserBorder}"/>
                                                        <Setter Property="Background" Value="{StaticResource Chat.UserBackground}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindName}" Value="ToolCall">
                                                        <Setter Property="BorderBrush" Value="#3B7A57"/>
                                                        <Setter Property="Background" Value="#1F2E24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                                        <Setter Property="BorderBrush" Value="#B0563C"/>
                                                        <Setter Property="Background" Value="#33221E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindName}" Value="Error">
                                                        <Setter Property="BorderBrush" Value="#B0563C"/>
                                                        <Setter Property="Background" Value="#331F1F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindName}" Value="Compaction">
                                                        <Setter Property="BorderBrush" Value="#6B6B2E"/>
                                                        <Setter Property="Background" Value="#262618"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                                        <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                                        <Setter Property="Background" Value="#1E2733"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Expander Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                                                          Foreground="{StaticResource Dark.Text}"
                                                          Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Text="{Binding Reasoning, Mode=OneWay}" TextWrapping="Wrap"
                                                             Foreground="#C8C8C8" FontStyle="Italic"
                                                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>
                                                </Expander>
                                                <ItemsControl ItemsSource="{Binding Blocks, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Content="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                                                    Style="{StaticResource IconButtonStyle}" Width="16" Height="16"
                                                    ToolTip="Copy message" Click="OnCopyMessage">
                                                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <ProgressBar x:Name="AgentProgress" Width="16" Height="16"
                                     IsIndeterminate="True" VerticalAlignment="Center"
                                     Foreground="{StaticResource Dark.Accent}" Visibility="Collapsed"/>
                        <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center"
                                   Margin="6,0,8,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Button x:Name="CancelButton" Content="Stop" Click="OnCancelSend"
                                Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="InputBox"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="OnInputKeyDown"/>
                        <Button Grid.Column="1" x:Name="SendButton" Width="28" Height="28"
                                Margin="8,0,0,0" VerticalAlignment="Bottom" Click="OnSend"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Send (Enter)">
                            <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                  Fill="{StaticResource Dark.Text}" Stretch="Uniform"
                                  Width="18" Height="18"/>
                        </Button>
                        <Button Grid.Column="2" x:Name="MicButton" Width="28" Height="28"
                                Margin="8,0,0,0" VerticalAlignment="Bottom"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Microphone">
                            <Path Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18">
                                <Path.Data>
                                    <GeometryGroup FillRule="Nonzero">
                                        <RectangleGeometry Rect="9,2,6,12" RadiusX="3" RadiusY="3"/>
                                        <PathGeometry Figures="M19,11 C19,14.53 16.39,17.44 13,17.93 L13,21 L11,21 L11,17.93 C7.61,17.44 5,14.53 5,11 L7,11 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 L19,11 Z"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#C8C8C8"/>
                        <RadioButton x:Name="PlanModeButton" Content="Plan" GroupName="AgentMode"
                                     IsChecked="True" Checked="OnModeChanged"
                                     Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ActModeButton" Content="Act" GroupName="AgentMode"
                                     Checked="OnModeChanged"
                                     Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
                        <Button x:Name="CompactNowButton" Content="Compact now" Click="OnCompactNow"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Summarize the conversation to free context space"/>
                        <Button x:Name="UpdateMemoryButton" Content="Memory bank" Click="OnUpdateMemory"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Ask the agent to update the project memory bank"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Spec">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Import spec" Click="OnImportSpec" Margin="0,5,8,0"/>
                    <Button Content="Find similar" Click="OnFindSimilar" Margin="0,5,8,0"/>
                    <Button Content="UiPath → WF" Click="OnConvertUiPath" Margin="0,5,8,0"/>
                </WrapPanel>
                <Border x:Name="NoticeBar" DockPanel.Dock="Top" Background="#4DFF8C00"
                        CornerRadius="2" Padding="10,6" Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="NoticeText" Foreground="#FFE3B3" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="ImportProgressPanel" DockPanel.Dock="Top" Background="{StaticResource Dark.Panel}"
                        BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"
                        Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ImportStatusText" Foreground="{StaticResource Dark.Text}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                                     Foreground="{StaticResource Dark.Accent}"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,0,4"
                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                            ToolTip="Copy all" Click="OnCopySpecOutput">
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                    <ScrollViewer Grid.Row="1" x:Name="SpecScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SpecList" ItemTemplate="{StaticResource MessageTemplate}">
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="KnowledgeBaseTab" Header="Knowledge base">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="64"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.5*" MinHeight="48"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <ComboBox x:Name="KbModeCombo" SelectedIndex="1" VerticalAlignment="Center" Margin="0,5,8,0">
                        <ComboBoxItem Content="Override (start over)"/>
                        <ComboBoxItem Content="Continue (resume)"/>
                    </ComboBox>
                    <Button x:Name="KbImportButton" Content="Import from robots" Click="OnFormKnowledgeBase" Margin="0,5,8,0"/>
                    <Button x:Name="KbPauseButton" Content="Pause" Click="OnPauseKnowledgeBaseImport" Margin="0,5,8,0" IsEnabled="False"/>
                    <Button x:Name="KbStopButton" Content="Stop" Click="OnStopKnowledgeBaseImport" Margin="0,5,8,0" IsEnabled="False"/>
                    <Button Content="Refresh" Click="OnRefreshKnowledgeBase" Margin="0,5,8,0"/>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="KbStatusText" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Foreground="#C8C8C8"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <ProgressBar Grid.Row="1" x:Name="KbProgressBar" Height="6" Margin="0,4,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource Dark.Accent}" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <ProgressBar x:Name="ContextFillBar" Width="120" Height="12"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource Dark.Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TokenUsageText" Margin="8,0,0,0" Foreground="#C8C8C8"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Text="Context window: —"/>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <Grid Grid.Row="3" Margin="0,4,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Messages:" VerticalAlignment="Center" Foreground="#C8C8C8"/>
                        <CheckBox x:Name="KbAutoScrollCheckBox" Content="Auto-scroll" IsChecked="True"
                                  VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="KbMessagesBox" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>

                <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <ListBox Grid.Row="5" x:Name="KbListBox" Background="{StaticResource Dark.Control}"
                         BorderBrush="{StaticResource Dark.Border}" Foreground="{StaticResource Dark.Text}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </TabItem>

        <TabItem x:Name="SettingsTab" Header="Settings">
            <Grid Margin="8" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BaseUrlBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModelBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="KB directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="KbPathBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Robot solutions directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="RobotsRootPathBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Robot template file name" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="RobotTemplateNameBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Rules directory (md)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="RulesPathBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Context window (tokens)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="ContextWindowBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Compact threshold (0..1)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="CompactThresholdBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Reserve fraction (0..1)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="ReserveFractionBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Keep recent messages" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="KeepRecentBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Tool result max chars" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="11" Grid.Column="1" x:Name="ToolResultMaxCharsBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Max agent iterations" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="12" Grid.Column="1" x:Name="MaxIterationsBox" Margin="0,0,0,4"/>

                <CheckBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoCompactCheckBox"
                          Content="Auto-compact (summarize)" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>

                <CheckBox Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UseToolRoleCheckBox"
                          Content="Use 'tool' role for tool results" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>


                <TextBlock Grid.Row="15" Grid.Column="0" Text="Log file path" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <DockPanel Grid.Row="15" Grid.Column="1" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" x:Name="OpenLogButton" Content="Open log" Click="OnOpenLog" Margin="8,0,0,0"/>
                    <TextBox x:Name="LogFilePathBox"/>
                </DockPanel>

                <TextBlock Grid.Row="16" Grid.Column="0" Text="Request timeout (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="16" Grid.Column="1" x:Name="TimeoutSecondsBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="17" Grid.Column="0" Text="Retry budget (min)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="17" Grid.Column="1" x:Name="RetryTimeoutMinutesBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="18" Grid.Column="0" Text="Retry base delay (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="18" Grid.Column="1" x:Name="RetryBaseDelaySecondsBox" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="19" Grid.Column="0" Text="Retry max delay (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="19" Grid.Column="1" x:Name="RetryMaxDelaySecondsBox" Margin="0,0,0,4"/>

                <Button Grid.Row="20" Grid.Column="1" Content="Save settings" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnSaveSettings"/>

                <Border Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RestorePackagesPanel"
                        Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Restore packages" Click="OnRestorePackages" VerticalAlignment="Center"/>
                        <TextBlock Text="Update-Package -Reinstall for the current solution" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                </Border>

                <Button Grid.Row="22" Grid.Column="1" Content="Refresh prompts from disk" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRefreshPromptsFromDisk"/>
            </Grid>
        </TabItem>

        <TabItem x:Name="PackagesTab" Header="Packages">
            <Grid Margin="8">
                <TextBlock Text="No package operations yet." Foreground="#C8C8C8"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
