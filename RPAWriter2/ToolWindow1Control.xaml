<UserControl x:Class="RPAWriter2.ToolWindow1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:core="clr-namespace:RPAWriter.Core.Services;assembly=RPAWriter.Core"
             xmlns:conv="clr-namespace:RPAWriter2.Converters"
             xmlns:controls="clr-namespace:RPAWriter2.Controls"
             xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
             Background="#2D2D30"
             Foreground="#F1F1F1"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPAWriter2;component/Styles/DarkScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Dark.Window" Color="#2D2D30"/>
        <SolidColorBrush x:Key="Dark.Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Dark.Control" Color="#333337"/>
        <SolidColorBrush x:Key="Dark.ControlHover" Color="#3E3E42"/>
        <SolidColorBrush x:Key="Dark.ControlPressed" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="Dark.Accent" Color="#264F78"/>
        <SolidColorBrush x:Key="Dark.ErrorText" Color="#F48771"/>
        <SolidColorBrush x:Key="Chat.UserBorder" Color="#CC64B5F6"/>
        <SolidColorBrush x:Key="Chat.UserBackground" Color="#3364B5F6"/>
        <SolidColorBrush x:Key="Commit.SuccessBackground" Color="#2E7D32"/>
        <SolidColorBrush x:Key="Commit.ErrorBackground" Color="#E65100"/>
        <SolidColorBrush x:Key="Chat.LastActBackground" Color="#334CAF50"/>
        <SolidColorBrush x:Key="Chat.LastActBorder" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#4DFF8C00"/>
        <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#FF8C00"/>
        <SolidColorBrush x:Key="Mode.PlanBrush" Color="#64B5F6"/>
        <SolidColorBrush x:Key="Mode.ActBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Mode.HelpBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="Deploy.WarningBackground" Color="#E65100"/>
        <SolidColorBrush x:Key="Deploy.SuccessBackground" Color="#B32E7D32"/>
        <SolidColorBrush x:Key="Material.Accent" Color="#64B5F6"/>
        <SolidColorBrush x:Key="Question.OptionBorder" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Question.AnswerBorder" Color="#4CAF50"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Code.Background" Color="#1E1E1E"/>
        <conv:CodeTokensToTextBlockConverter x:Key="CodeToTextBlock"/>
        <conv:MarkdownToElementConverter x:Key="MarkdownToElement"/>
        <conv:MaterialIconToGeometryConverter x:Key="MaterialIconToGeometry"/>
        <conv:OptionEqualsAnswerConverter x:Key="OptionEqualsAnswerConverter"/>

        <Style x:Key="CodeScrollViewerStyle" TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="OnCodeScrollPreviewMouseWheel"/>
        </Style>

        <DataTemplate DataType="{x:Type core:TextMessageBlock}">
            <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.KindName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource Dark.ErrorText}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:CodeMessageBlock}">
            <Border Background="{StaticResource Code.Background}" BorderBrush="{StaticResource Dark.Border}"
                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                <ScrollViewer Style="{StaticResource CodeScrollViewerStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Tokens, Mode=OneWay, Converter={StaticResource CodeToTextBlock}}"/>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Dark.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{StaticResource Dark.Text}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="{StaticResource Dark.Text}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"
                                                      Width="8" Height="4"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Dark.Control}"
                                        BorderBrush="{StaticResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Dark.Control}"
                                        BorderBrush="{StaticResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Path Data="M 0,0 L 4,4 L 8,0 Z"
                                                  Fill="{StaticResource Dark.Text}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Width="8" Height="4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{StaticResource Dark.Text}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{StaticResource Dark.Accent}"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource Dark.Control}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Dark.ControlHover}"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.Accent}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Dark.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Dark.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dark.Text}"/>
            <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="2,2,0,0" Padding="14,6" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.Panel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dark.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Dark.ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ChatMessageTemplate">
            <Border CornerRadius="2" Padding="8,6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KindName}" Value="User">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.UserBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.UserBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ToolCall">
                                <Setter Property="BorderBrush" Value="{StaticResource Dark.Border}"/>
                                <Setter Property="Background" Value="{StaticResource Dark.Control}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                <Setter Property="BorderBrush" Value="#B0563C"/>
                                <Setter Property="Background" Value="#33221E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Error">
                                <Setter Property="BorderBrush" Value="#B0563C"/>
                                <Setter Property="Background" Value="#331F1F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Compaction">
                                <Setter Property="BorderBrush" Value="#6B6B2E"/>
                                <Setter Property="Background" Value="#262618"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Question">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                                <Setter Property="BorderBrush" Value="#4A6B9A"/>
                                <Setter Property="Background" Value="#1E2733"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.LastPlanBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.LastPlanBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                                <Setter Property="BorderBrush" Value="{StaticResource Chat.LastActBorder}"/>
                                <Setter Property="Background" Value="{StaticResource Chat.LastActBackground}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Expander Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                                  Foreground="{StaticResource Dark.Text}"
                                  Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Reasoning, Mode=OneWay}" TextWrapping="Wrap"
                                     Foreground="#C8C8C8" FontStyle="Italic"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Expander>
                        <StackPanel x:Name="QuestionPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Payload.Question}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{StaticResource Dark.Text}"/>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.IsAnswered}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding Payload.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}" Click="OnQuestionOptionClick"
                                                    Margin="0,0,6,4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Question.OptionBorder}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Padding" Value="10,4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource OptionEqualsAnswerConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.Payload.Answer" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Skip" Click="OnQuestionSkip" HorizontalAlignment="Left"
                                        Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Question.OptionBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Payload.IsSkipped}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Question.AnswerBorder}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="SubagentPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Payload.Item.Prompt}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Dark.Text}"/>
                            <TextBlock Text="{Binding Payload.Item.StatusText}" Foreground="#C8C8C8" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Payload.Item.LatestToolCall}" Foreground="#9A9A9A" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Payload.Item.LatestToolCall}"/>
                            <Expander Header="Show output" Margin="0,8,0,0" Foreground="{StaticResource Dark.Text}" IsExpanded="False"
                                      Visibility="{Binding Payload.Item.HasOutput, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding Payload.Item.Result, Mode=OneWay}" TextWrapping="Wrap"
                                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{StaticResource Dark.Text}" MaxHeight="400" VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                            <TextBlock Text="{Binding Payload.Item.Error}" Foreground="{StaticResource Dark.ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Payload.Item.HasError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel x:Name="MarkdownPanel" Visibility="Collapsed">
                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Dark.Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ContentControl Content="{Binding Text, Mode=OneWay, Converter={StaticResource MarkdownToElement}}"/>
                        </StackPanel>
                        <ItemsControl x:Name="BlocksPanel" ItemsSource="{Binding Blocks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="{Binding TimestampLocal, StringFormat=HH:mm}"
                                   Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="{Binding TimestampLocal, StringFormat=g}"/>
                        <Button VerticalAlignment="Top"
                                Style="{StaticResource IconButtonStyle}" Width="16" Height="16"
                                ToolTip="Copy message" Click="OnCopyMessage">
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KindName}" Value="Question">
                    <Setter TargetName="QuestionPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                    <Setter TargetName="SubagentPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                    <Setter TargetName="MarkdownPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                    <Setter TargetName="MarkdownPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BlocksPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MessageSampleTemplate">
            <StackPanel Margin="0,0,0,10">
                <Border Background="Transparent" BorderBrush="{Binding Accent}" BorderThickness="{Binding BorderThickness}" CornerRadius="2" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Copy" Click="OnCopyMessageSample"
                                Visibility="{Binding ShowCopy, Converter={StaticResource BoolToVis}}">
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Fill="{Binding Foreground}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Add to chat input" Click="OnSendMessageSample"
                                Visibility="{Binding ShowSend, Converter={StaticResource BoolToVis}}">
                            <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                  Fill="{Binding Foreground}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" Margin="8,-3,0,-3"
                                VerticalAlignment="Center" ToolTip="Close"
                                Visibility="{Binding ShowClose, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✕" FontSize="12" Foreground="{Binding Foreground}"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl x:Name="MainTabs" Margin="8">
        <TabItem Header="Chat">
            <Grid x:Name="ChatRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="60"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ChatToolbarPanel" Grid.Row="0" Margin="0,0,0,6">
                    <controls:NotificationBanner x:Name="DeployToast" Margin="0,0,0,6" Visibility="Collapsed"
                                                  CloseRequested="OnDeployToastClose"
                                                  SendToChatRequested="OnNotificationSendToChat"/>
                    <controls:NotificationBanner x:Name="VoiceErrorToast" Margin="0,0,0,6" Visibility="Collapsed"
                                                  CloseRequested="OnVoiceErrorClose"
                                                  SendToChatRequested="OnNotificationSendToChat"/>
                    <WrapPanel Margin="0,5,0,6" TextElement.FontSize="14">
                        <Button Content="New chat" Click="OnNewChat" Margin="0,0,8,4"/>
                        <Button Content="history" Click="OnShowHistory" Margin="0,0,8,4"/>
                        <Button Content="commit" Click="OnCommit" Margin="0,0,8,4"/>
                        <Button Content="deploy" Click="OnDeploy" Margin="0,0,8,4"/>
                        <Button Content="Analyze logs" Click="OnAnalyzeLogs" Margin="0,0,8,4"/>
                        <Button Content="send errors" Click="OnSendErrors" Margin="0,0,8,4"/>
                        <Button Content="copy" Click="OnCopyConversation" Margin="0,0,8,4"/>
                    </WrapPanel>
                    <controls:NotificationBanner x:Name="OptionsWarningToast" Margin="0,0,0,6" Visibility="Collapsed"
                                                  CloseRequested="OnOptionsWarningClose"
                                                  SendToChatRequested="OnNotificationSendToChat"/>
                    <controls:NotificationBanner x:Name="CommitResultBar" Margin="0,0,0,6" Visibility="Collapsed"
                                                  CloseRequested="OnCloseCommitResult"
                                                  SendToChatRequested="OnNotificationSendToChat"/>
                    <Border x:Name="CreateRobotPanel" Margin="0,0,0,6"
                            Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Robot number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RobotNumberBox" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                                     PreviewTextInput="OnRobotNumberPreviewTextInput"/>
                            <Button Content="Create robot" Click="OnCreateRobot" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="CommitControlHost" Grid.Row="1" Margin="0,0,0,6"
                        Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="8,6" Visibility="Collapsed">
                    <StackPanel>
                        <controls:NotificationBanner x:Name="CommitWarningBar" Visibility="Collapsed"
                                                      CloseRequested="OnCommitClose"
                                                      SendToChatRequested="OnNotificationSendToChat"/>
                        <Grid x:Name="CommitEditorPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Commit message:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                        VerticalAlignment="Top" ToolTip="Close" Click="OnCommitClose">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                                </Button>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="CommitMessageBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="CommitSendButton" Content="Commit" Click="OnCommitSend" Padding="10,2"/>
                                <Button x:Name="CommitAutoGenButton" Content="Auto-generate message" Click="OnCommitAutoGenerate" Padding="10,2" Margin="8,0,0,0"/>
                                <TextBlock x:Name="CommitStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="#C8C8C8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="PinnedHeaderPanel" Grid.Row="2" Margin="0,0,0,4"
                        Background="{StaticResource Chat.UserBackground}"
                        BorderBrush="{StaticResource Chat.UserBorder}"
                        BorderThickness="1" CornerRadius="2" Padding="8,6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                    VerticalAlignment="Top" Click="OnPinnedExpandToggle"
                                    ToolTip="Expand/collapse message">
                                <Viewbox Width="16" Height="16">
                                    <Polyline x:Name="PinnedExpandGlyph"
                                              Points="9,18 15,12 9,6"
                                              Stroke="{StaticResource Dark.Text}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                </Viewbox>
                            </Button>
                            <TextBlock x:Name="PinnedSummaryText" Grid.Column="1" Margin="8,0,8,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SingleLineDisplayText, Mode=OneWay}"/>
                            <ScrollViewer x:Name="PinnedTextScroll" Grid.Column="1" Margin="8,0,8,0"
                                          VerticalAlignment="Top" MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="Collapsed">
                                <ItemsControl ItemsSource="{Binding Blocks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                    VerticalAlignment="Top" Margin="8,0,0,0"
                                    ToolTip="Close chat (show history)" Click="OnCloseChat">
                                <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource Dark.Text}"/>
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="ChatContextFillBar" Grid.Row="1" Height="4" Margin="0,6,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource Dark.Accent}"/>
                        <TextBlock x:Name="ChatTokenUsageText" Grid.Row="2" Margin="0,4,0,0"
                                   Foreground="#C8C8C8" Text="Context window: —"/>
                    </Grid>
                </Border>

                <controls:ChatMessagesControl x:Name="ChatMessages" Grid.Row="3" Margin="0,0,0,4"/>

                <GridSplitter x:Name="ChatSplitter" Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <Grid x:Name="ChatInputPanel" Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <ProgressBar x:Name="AgentProgress" Width="16" Height="16"
                                     IsIndeterminate="True" VerticalAlignment="Center"
                                     Foreground="{StaticResource Dark.Accent}" Visibility="Collapsed"/>
                        <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center"
                                   Margin="6,0,8,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Row="1" Content="Cancel" FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,0,8" Click="OnCancelSend" Visibility="Collapsed"/>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="0" x:Name="AttachmentsList" Margin="0,0,0,4" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Dark.Control}" BorderBrush="{StaticResource Dark.Border}"
                                            BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Dark.Text}" FontSize="13"/>
                                            <Button Content="✕" Width="16" Height="16" Margin="6,0,0,0"
                                                    Style="{StaticResource IconButtonStyle}" FontSize="10"
                                                    Tag="{Binding}" Click="OnRemoveAttachment" ToolTip="Remove attachment"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InputBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="17"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="OnInputKeyDown"/>
                            <Button Grid.Column="1" x:Name="AttachButton" Width="28" Height="28"
                                    Margin="8,0,0,5" VerticalAlignment="Bottom" Click="OnAttach"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Attach image or file">
                                <Path Data="M16.5,6v11.5a4,4 0 0 1 -8,0V5a2.5,2.5 0 0 1 5,0v10.5a1,1 0 0 1 -2,0V6H10v9.5a2.5,2.5 0 0 0 5,0V5a4,4 0 0 0 -8,0v12.5a5.5,5.5 0 0 0 11,0V6h-1.5z"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform"
                                      Width="14" Height="14"/>
                            </Button>
                            <Button Grid.Column="2" x:Name="SendButton" Width="28" Height="28"
                                    Margin="8,0,0,5" VerticalAlignment="Bottom" Click="OnSend"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Send (Enter)">
                                <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform"
                                      Width="14" Height="14"/>
                            </Button>
                            <Button Grid.Column="3" x:Name="MicButton" Width="28" Height="28"
                                    Margin="8,0,0,5" VerticalAlignment="Bottom" Click="OnMicClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Start voice input">
                                <Path x:Name="MicIcon" Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14">
                                    <Path.Data>
                                        <GeometryGroup FillRule="Nonzero">
                                            <RectangleGeometry Rect="9,2,6,12" RadiusX="3" RadiusY="3"/>
                                            <PathGeometry Figures="M19,11 C19,14.53 16.39,17.44 13,17.93 L13,21 L11,21 L11,17.93 C7.61,17.44 5,14.53 5,11 L7,11 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 L19,11 Z"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Button>
                            <Button Grid.Column="4" x:Name="ClearInputButton" Width="28" Height="28"
                                    Margin="8,0,0,5" VerticalAlignment="Bottom" Click="OnClearInput"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Clear message">
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Broom}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,5">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#C8C8C8"/>
                        <controls:SegmentedToggle x:Name="ModeToggle" VerticalAlignment="Center"
                                                  SelectedValue="Plan" ValueChanged="OnModeChanged">
                            <controls:SegmentedToggle.Items>
                                <controls:SegmentedToggleItem Label="Plan" Value="Plan" Accent="{StaticResource Mode.PlanBrush}"/>
                                <controls:SegmentedToggleItem Label="Act" Value="Act" Accent="{StaticResource Mode.ActBrush}"/>
                                <controls:SegmentedToggleItem Label="Help" Value="Help" Accent="{StaticResource Mode.HelpBrush}"/>
                            </controls:SegmentedToggle.Items>
                        </controls:SegmentedToggle>
                        <Button x:Name="CompactNowButton" Content="Compact now" Click="OnCompactNow"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Summarize the conversation to free context space"/>
                        <Button x:Name="UpdateMemoryButton" Content="Memory bank" Click="OnUpdateMemory"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Ask the agent to update the project memory bank"/>
                        <Button x:Name="PermissionsButton" Content="Permissions" Click="OnPermissionsClick"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Configure agent permissions (read files, edit files, execute commands, web fetch, MCP)"/>
                        <Button x:Name="DocsButton" Content="Docs" Click="OnDocsClick"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Open the documentation"/>
                        <Button x:Name="DoItButton" Content="Do it!!!" Click="OnDoItClick"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Send 'Do it!!!' to the agent"/>
                    </StackPanel>

                    <Border x:Name="PermissionsOverlay" Grid.Row="0" Grid.RowSpan="4"
                            Background="{StaticResource Dark.Panel}"
                            BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                            CornerRadius="2" Padding="12,10" Visibility="Collapsed">
                        <StackPanel TextElement.FontSize="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Agent permissions" FontWeight="Bold"
                                           Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                        ToolTip="Close" Click="OnPermissionsClose">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="AllowReadFilesCheckBox" Content="Read files"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,8,0,0"
                                      Foreground="{StaticResource Dark.Text}"/>
                            <CheckBox x:Name="AllowEditFilesCheckBox" Content="Edit files"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{StaticResource Dark.Text}"/>
                            <CheckBox x:Name="AllowExecuteCommandCheckBox" Content="Execute commands (PowerShell)"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{StaticResource Dark.Text}"/>
                            <CheckBox x:Name="AllowWebFetchCheckBox" Content="Web fetch"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{StaticResource Dark.Text}"/>
                            <CheckBox x:Name="AllowMcpCheckBox" Content="MCP"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{StaticResource Dark.Text}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DocsOverlay" Grid.Row="0" Grid.RowSpan="6"
                        Background="{StaticResource Dark.Window}"
                        BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                        CornerRadius="2" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DocsTitleText" Grid.Column="0" Text="Documentation"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Home" Click="OnDocsHome" Padding="8,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Back to the documentation index"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Close" Click="OnDocsClose">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="DocsScroll"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="DocsContent" Margin="4"
                                            HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid x:Name="HistoryViewPanel" Grid.Row="0" Grid.RowSpan="6"
                      Background="{StaticResource Dark.Window}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="New chat" Click="OnNewChat" Margin="0,5,0,0"/>
                        <Button HorizontalAlignment="Right" Content="Clear history" Click="OnClearHistory" Margin="0,5,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Chat history" FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,16,0,8" Foreground="{StaticResource Dark.Text}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Center" Width="420">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Button HorizontalContentAlignment="Stretch" Click="OnHistoryCardClick" Padding="10,8,32,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CardTitle}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Dark.Text}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DisplayDate}" Margin="0,4,0,0"
                                                           Foreground="#9E9E9E"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                ToolTip="Delete chat" Click="OnDeleteHistoryCard">
                                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AnalyzeLogsPanel" Grid.Row="0" Grid.RowSpan="6"
                      Background="{StaticResource Dark.Window}" Visibility="Collapsed">
                    <Border Margin="8"
                            Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Log source:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                            VerticalAlignment="Top" ToolTip="Close" Click="OnCloseAnalyzeLogs">
                                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource Dark.Text}"/>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="From Visual Studio Output window" Click="OnAnalyzeLogsFromOutputWindow" Margin="0,0,8,0"/>
                                    <Button Content="From production servers" Click="OnAnalyzeLogsFromProdServers"/>
                                </StackPanel>

                                <Grid x:Name="ProdLogsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Robot name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="RobotNameBox" Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  IsEditable="True" Style="{StaticResource EditableComboBoxStyle}"
                                                  KeyDown="OnRobotNameKeyDown"/>
                                        <Button Content="Load tasks" Click="OnLoadProdTasks" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ProviderCombo" Width="200" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  SelectionChanged="OnProviderChanged" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" x:Name="ProdLogsStatusText" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="2" Text="Tasks:" Foreground="#C8C8C8" Margin="0,0,0,2"/>
                                    <DataGrid Grid.Row="3" x:Name="TasksGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                              SelectionMode="Single" SelectionChanged="OnTaskSelected"
                                              CanUserAddRows="False" MinHeight="80" MaxHeight="160" Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="4" Text="Logs:" Foreground="#C8C8C8" Margin="0,0,0,2"/>
                                    <DataGrid Grid.Row="5" x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                              SelectionMode="Single" CanUserAddRows="False"
                                              MinHeight="80" MaxHeight="180" Margin="0,0,0,6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="Auto"/>
                                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Grid.Row="6" Content="Analyze logs" Click="OnAnalyzeProdLogs" HorizontalAlignment="Left" Padding="10,2"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Spec">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Import spec" Click="OnImportSpec" Margin="0,5,8,0"/>
                    <Button Content="Generate algorithm" Click="OnGenerateAlgorithm" Margin="0,5,8,0"/>
                    <Button Content="Generate robot" Click="OnGenerateRobot" Margin="0,5,8,0"/>
                    <Button Content="Find similar" Click="OnFindSimilar" Margin="0,5,8,0"/>
                    <Button Content="Robot security audit" Click="OnRobotSecurityAudit" Margin="0,5,8,0"/>
                    <Button Content="Convert md to docx" Click="OnConvertMarkdownToDocx" Margin="0,5,8,0"/>
                    <Button Content="Clear" Click="OnClearSpec" Margin="0,5,8,0"/>
                </WrapPanel>
                <controls:NotificationBanner x:Name="NoticeBar" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed"
                                              CloseRequested="OnNoticeClose"
                                              SendToChatRequested="OnNotificationSendToChat"/>
                <Border x:Name="ImportProgressPanel" DockPanel.Dock="Top" Background="{StaticResource Dark.Panel}"
                        BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"
                        Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ImportStatusText" Foreground="{StaticResource Dark.Text}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,6,0,0" IsIndeterminate="True"
                                     Foreground="{StaticResource Dark.Accent}"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="CopySpecAllButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,0,4"
                            Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                            ToolTip="Copy all" Click="OnCopySpecOutput" Visibility="Collapsed">
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                    <controls:ChatMessagesControl x:Name="SpecMessages" Grid.Row="1"/>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="KnowledgeBaseTab" Header="Knowledge base">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="64"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <ComboBox x:Name="KbModeCombo" SelectedIndex="1" VerticalAlignment="Center" Margin="0,5,8,0">
                        <ComboBoxItem Content="Override (start over)"/>
                        <ComboBoxItem Content="Continue (resume)"/>
                    </ComboBox>
                    <Button x:Name="KbImportButton" Content="Import from robots" Click="OnFormKnowledgeBase" Margin="0,5,8,0"/>
                    <Button x:Name="KbPauseButton" Content="Pause" Click="OnPauseKnowledgeBaseImport" Margin="0,5,8,0" IsEnabled="False"/>
                    <Button x:Name="KbStopButton" Content="Stop" Click="OnStopKnowledgeBaseImport" Margin="0,5,8,0" IsEnabled="False"/>
                    <Button Content="Refresh" Click="OnRefreshKnowledgeBase" Margin="0,5,8,0"/>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="KbStatusText" IsReadOnly="True"
                             Height="80" MaxLines="3"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Foreground="#C8C8C8"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <ProgressBar Grid.Row="1" x:Name="KbProgressBar" Height="6" Margin="0,4,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource Dark.Accent}" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <ProgressBar x:Name="ContextFillBar" Width="120" Height="12"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource Dark.Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TokenUsageText" Margin="8,0,0,0" Foreground="#C8C8C8"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Text="Context window: —"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,4,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Messages:" VerticalAlignment="Center" Foreground="#C8C8C8"/>
                        <CheckBox x:Name="KbAutoScrollCheckBox" Content="Auto-scroll" IsChecked="True"
                                  VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="KbMessagesBox" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>

            </Grid>
        </TabItem>

        <TabItem x:Name="SettingsTab" Header="Settings">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:NotificationBanner x:Name="SettingsToast" Grid.Row="0" Margin="8,8,8,4" Visibility="Collapsed"
                                              CloseRequested="OnSettingsToastClose"
                                              SendToChatRequested="OnNotificationSendToChat"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4,8,4">
                    <Button Content="Save settings" Margin="0,5,8,0" Click="OnSaveSettings"/>
                </StackPanel>
                <TabControl x:Name="SettingsSubTabs" Grid.Row="2" Margin="8">
                    <TabItem Header="API">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="8" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BaseUrlBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModelBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Slider x:Name="TemperatureSlider" Width="200" Minimum="0" Maximum="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            SmallChange="0.1" LargeChange="0.2"
                                            ValueChanged="OnTemperatureChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TemperatureValueText" Text="0.2" VerticalAlignment="Center"
                                               Margin="10,0,0,0" Width="40" Foreground="{StaticResource Dark.Text}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Context window (tokens)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ContextWindowBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Compact threshold (0..1)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CompactThresholdBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Reserve fraction (0..1)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="ReserveFractionBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Keep recent messages" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="7" Grid.Column="1" x:Name="KeepRecentBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Tool result max chars" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="8" Grid.Column="1" x:Name="ToolResultMaxCharsBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Max agent iterations" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="9" Grid.Column="1" x:Name="MaxIterationsBox" Margin="0,0,0,4"/>

                                <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoCompactCheckBox"
                                          Content="Auto-compact (summarize)" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>

                                <CheckBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UseToolRoleCheckBox"
                                          Content="Use 'tool' role for tool results" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Tool calling" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ComboBox Grid.Row="12" Grid.Column="1" x:Name="ToolCallingModeCombo" SelectedIndex="0"
                                          VerticalAlignment="Center" Margin="0,0,0,4">
                                    <ComboBoxItem Content="JSON over chat (compatible)"/>
                                    <ComboBoxItem Content="Native function calling"/>
                                </ComboBox>

                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Memory bank" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ComboBox Grid.Row="13" Grid.Column="1" x:Name="MemoryBankModeCombo" SelectedIndex="0"
                                          VerticalAlignment="Center" Margin="0,0,0,4">
                                    <ComboBoxItem Content="Disabled"/>
                                    <ComboBoxItem Content="Tool (read_memory / update_memory)"/>
                                    <ComboBoxItem Content="Convention (read/update with file tools)"/>
                                </ComboBox>

                                <TextBlock Grid.Row="14" Grid.Column="0" Text="Request timeout (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="14" Grid.Column="1" x:Name="TimeoutSecondsBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="15" Grid.Column="0" Text="Retry budget (min)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="15" Grid.Column="1" x:Name="RetryTimeoutMinutesBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="16" Grid.Column="0" Text="Retry base delay (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="16" Grid.Column="1" x:Name="RetryBaseDelaySecondsBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="17" Grid.Column="0" Text="Retry max delay (s)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="17" Grid.Column="1" x:Name="RetryMaxDelaySecondsBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="18" Grid.Column="0" Text="Input price ($/1M tokens)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="18" Grid.Column="1" x:Name="InputPriceBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="19" Grid.Column="0" Text="Cache-hit price ($/1M tokens)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="19" Grid.Column="1" x:Name="CacheHitPriceBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="20" Grid.Column="0" Text="Output price ($/1M tokens)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="20" Grid.Column="1" x:Name="OutputPriceBox" Margin="0,0,0,4"/>

                                <CheckBox Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AllowSubagentsCheckBox"
                                          Content="Enable sub-agents (spawn_agent)" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>

                                <TextBlock Grid.Row="22" Grid.Column="0" Text="Sub-agent max iterations" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="22" Grid.Column="1" x:Name="SubagentMaxIterationsBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="23" Grid.Column="0" Text="Sub-agent max depth" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="23" Grid.Column="1" x:Name="SubagentMaxDepthBox" Margin="0,0,0,4"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="RPA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="8" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="KB directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="KbPathBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Robot solutions directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="RobotsRootPathBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Robot template file name" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="RobotTemplateNameBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rules directory (md)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="RulesPathBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Packages directory (NuGet source)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PackagesPathBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Log providers directory" VerticalAlignment="Center" Margin="0,8,8,4"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="LogProvidersPathBox" Margin="0,8,0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Skills directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SkillsPathBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Security audit mode" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="SecurityAuditModeCombo" SelectedIndex="0"
                                          VerticalAlignment="Center" Margin="0,0,0,4">
                                    <ComboBoxItem Content="Full (all areas)"/>
                                    <ComboBoxItem Content="Passwords &amp; logins only"/>
                                </ComboBox>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="8" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Log file path" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" x:Name="OpenLogButton" Content="Open log" Click="OnOpenLog" Margin="8,0,0,0"/>
                                    <TextBox x:Name="LogFilePathBox"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chat log file path" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" x:Name="OpenChatLogButton" Content="Open log" Click="OnOpenChatLog" Margin="8,0,0,0"/>
                                    <TextBox x:Name="ChatLogFilePathBox"/>
                                </DockPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="User name" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserNameBox" Margin="0,0,0,4"/>

                                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AddressByNameCheckBox"
                                          Content="Address me by name" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>

                                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ShowControlsCheckBox"
                                          Content="Show controls" Margin="0,8,0,4" Foreground="{StaticResource Dark.Text}"/>

                                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Open RPA Writer Converter →"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Background="Transparent" BorderThickness="0" Foreground="#64B5F6" Cursor="Hand"
                                        Click="OnOpenConverterToolWindow">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                                       Foreground="{TemplateBinding Foreground}" Cursor="Hand"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Refresh prompts from disk"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRefreshPromptsFromDisk"/>

                                <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Content="Export documentation"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnExportDocumentation"/>

                                <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="Export prompts"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnExportPrompts"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Sound">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="8" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Speech recognition" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SpeechToTextProviderCombo" SelectedIndex="0"
                                          VerticalAlignment="Center" Margin="0,0,0,4">
                                    <ComboBoxItem Content="Auto (Whisper, fallback Vosk)"/>
                                    <ComboBoxItem Content="OpenAI Whisper"/>
                                    <ComboBoxItem Content="Vosk (offline)"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Whisper STT model" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SpeechToTextModelBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Speech language" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SpeechToTextLanguageBox" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vosk model directory" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="VoskModelPathBox" Margin="0,0,0,4"/>

                                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SpeechAutoSendCheckBox"
                                          Content="Auto-send voice input" Margin="0,2,0,4" Foreground="{StaticResource Dark.Text}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </TabItem>

        <TabItem x:Name="PackagesTab" Header="Packages">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="Refresh" Click="OnRefreshPackages" Margin="0,5,8,0"/>
                    <Button Content="Install selected" Click="OnInstallSelectedPackages" Margin="0,5,8,0"/>
                    <Button Content="Update selected" Click="OnUpdateSelectedPackages" Margin="0,5,8,0"/>
                    <Button Content="Uninstall selected" Click="OnUninstallSelectedPackages" Margin="0,5,8,0"/>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="16,5,6,0"/>
                    <TextBox x:Name="PackageFilterBox" Text="Activities." Width="180"
                             TextChanged="OnPackageFilterChanged" VerticalContentAlignment="Center"
                             ToolTip="Show packages whose name starts with this value" Margin="0,5,0,0"/>
                </WrapPanel>

                <TextBlock Grid.Row="1" x:Name="PackagesStatusText" Foreground="#C8C8C8"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                <ListView Grid.Row="2" x:Name="PackagesList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" Margin="8,0,0,0"
                                               Foreground="{StaticResource Dark.Text}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                              Width="120" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding InstalledBadge}" Margin="8,0,0,0" Foreground="#7AC88F" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Margin="24,2,0,0" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="RestorePackagesPanel" Grid.Row="3"
                        Background="{StaticResource Dark.Panel}" BorderBrush="{StaticResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Restore packages" Click="OnRestorePackages" VerticalAlignment="Center"/>
                        <TextBlock Text="Update-Package -Reinstall for the current solution" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="#C8C8C8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem x:Name="ControlsTab" Header="Controls" Visibility="Collapsed">
            <TabControl x:Name="ControlsInnerTabs" Margin="4">
                <TabItem x:Name="NotificationsTab" Header="Notifications">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Auto-hide (s) — 0 = never" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="NotificationAutoHideBox" Text="5" Width="60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="ReplayNotificationsButton" Content="Replay" Click="OnReplayNotifications" VerticalAlignment="Center" Padding="8,2"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ControlsMessagesList" ItemTemplate="{StaticResource MessageSampleTemplate}" Margin="8"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Chat">
                    <ListBox x:Name="ControlsChatList"
                             Background="{StaticResource Dark.Panel}"
                             BorderThickness="0"
                             Margin="8"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="2,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ItemTemplate="{StaticResource ChatMessageTemplate}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </TabItem>
                <TabItem Header="SVG">
                    <DockPanel Margin="8">
                        <TextBox x:Name="SvgSearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                                 TextChanged="OnSvgSearchTextChanged"
                                 ToolTip="Search icons by identifier"/>
                        <ListBox x:Name="ControlsSvgList"
                                 Background="{StaticResource Dark.Panel}"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLength="2,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ChildSize="112,108"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="104" Background="{StaticResource Dark.Control}"
                                            BorderBrush="{StaticResource Dark.Border}" BorderThickness="1"
                                            CornerRadius="2" Padding="8">
                                        <StackPanel>
                                            <Path Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                  Fill="{StaticResource Dark.Text}"
                                                  Data="{Binding Kind, Converter={StaticResource MaterialIconToGeometry}}"/>
                                            <TextBlock Text="{Binding Identifier}" Margin="0,6,0,0" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Identifier}"
                                                       FontSize="10" Foreground="{StaticResource Dark.Text}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                <Button Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                        Margin="0,0,4,0" ToolTip="Copy identifier"
                                                        Click="OnCopySvgIdentifier">
                                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                          Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                        Margin="4,0,0,0" ToolTip="Add to chat input"
                                                        Click="OnSendSvgIdentifier">
                                                    <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                                          Fill="{StaticResource Dark.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Palette">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ControlsPaletteList" Margin="8">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,4" Foreground="#C8C8C8"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="22" Background="{Binding Brush}"
                                                BorderBrush="{StaticResource Dark.Border}" BorderThickness="1" CornerRadius="2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{StaticResource Dark.Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Hex}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontFamily="Consolas" Foreground="#C8C8C8"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </TabItem>

    </TabControl>
</UserControl>