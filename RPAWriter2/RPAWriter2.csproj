<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="RPAWriter2Package.vsct" />
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Material.Icons" Version="3.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="4.6.8" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Oracle.ManagedDataAccess" Version="19.8.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared agent toolkit (generic core, MVVM primitives, product models and shared WPF
         controls) — consumed as NuGet packages from the AgentShared feed. -->
    <PackageReference Include="AgentToolkit" Version="1.15.1" />
    <PackageReference Include="AgentToolkit.Wpf" Version="1.15.1" />
    <!-- RPA-specific layer (robot generation, spec analysis, converters, log analysis). -->
    <ProjectReference Include="..\Agent.Rpa\Agent.Rpa.csproj" />
    <!-- Roslyn semantic analysis shared with the tests (pure, no VS dependency). -->
    <ProjectReference Include="..\RPAWriter.Roslyn\RPAWriter.Roslyn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- VSSDK excludes Newtonsoft.Json from the VSIX by default; force-include it
         because Agent.Core.dll depends on it and VS does not resolve it for third-party extensions. -->
    <VSIXSourceItem Include="$(OutputPath)Newtonsoft.Json.dll" />
    <VSIXSourceItem Include="$(OutputPath)NLog.dll" />
    <VSIXSourceItem Include="$(OutputPath)Markdig.dll" />
    <VSIXSourceItem Include="$(OutputPath)Material.Icons.dll" />
    <!-- Markdig's transitive dependencies are not auto-packaged by VSSDK for SDK-style
         projects. Ship them explicitly, otherwise Markdig fails at runtime with
         "Could not load file or assembly 'System.Memory, Version=4.0.5.0'". -->
    <VSIXSourceItem Include="$(OutputPath)System.Memory.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Buffers.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Numerics.Vectors.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Threading.Tasks.Extensions.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.ValueTuple.dll" />
    <!-- PIX activity importer: MetadataLoadContext reflects over the installed .NET 7 PIX
         assemblies. Its transitive dependencies are not auto-packaged by VSSDK, so ship them. -->
    <VSIXSourceItem Include="$(OutputPath)System.Reflection.MetadataLoadContext.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Reflection.Metadata.dll" />
    <VSIXSourceItem Include="$(OutputPath)System.Collections.Immutable.dll" />
    <!-- Speech-to-text runtime dependencies: NAudio (microphone capture) and Vosk (offline STT). -->
    <VSIXSourceItem Include="$(OutputPath)NAudio.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.Core.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.WinMM.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.Wasapi.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.Midi.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.Asio.dll" />
    <VSIXSourceItem Include="$(OutputPath)NAudio.WinForms.dll" />
    <VSIXSourceItem Include="$(OutputPath)Vosk.dll" />
    <!-- Native Vosk binaries (win-x64) and their MinGW runtime dependencies. -->
    <VSIXSourceItem Include="$(OutputPath)libvosk.dll" />
    <VSIXSourceItem Include="$(OutputPath)libgcc_s_seh-1.dll" />
    <VSIXSourceItem Include="$(OutputPath)libstdc++-6.dll" />
    <VSIXSourceItem Include="$(OutputPath)libwinpthread-1.dll" />
    <!-- WebView2 (Mermaid diagram rendering): managed assemblies + native loader. -->
    <VSIXSourceItem Include="$(OutputPath)Microsoft.Web.WebView2.Core.dll" />
    <VSIXSourceItem Include="$(OutputPath)Microsoft.Web.WebView2.Wpf.dll" />
    <VSIXSourceItem Include="$(OutputPath)WebView2Loader.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Data.SQLite native interop must ship under x86/x64 subfolders so the
         managed provider can locate SQLite.Interop.dll at runtime inside the VSIX.
         The package's buildTransitive targets do not copy the interop for SDK-style
         projects, so we copy it ourselves and then package it. -->
    <Content Include="$(OutputPath)x86\SQLite.Interop.dll">
      <Link>x86\SQLite.Interop.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(OutputPath)x64\SQLite.Interop.dll">
      <Link>x64\SQLite.Interop.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <Target Name="CopySqliteInteropToOutput" BeforeTargets="GetVsixSourceItems">
    <Copy SourceFiles="$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.119\build\net46\x86\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x86" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.119\build\net46\x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x64" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="ResolveRoslynReferences" BeforeTargets="ResolveAssemblyReferences">
    <!--
      Reference the Roslyn assemblies shipped with the installed Visual Studio. Resolve from the oldest supported VS (2022 / 17.x / Roslyn 4.x), not "vswhere -latest", so one VSIX loads in both VS 2022 and VS 2026.
      This guarantees the types match the in-proc VisualStudioWorkspace at runtime, and keeps the
      VSIX from shipping its own Roslyn copies (VS already provides them). Override RoslynVsInstallRoot to
      point at the Visual Studio installation root.
    -->
    <PropertyGroup>
      <RoslynVsInstallRoot Condition="'$(RoslynVsInstallRoot)' == ''"></RoslynVsInstallRoot>
    </PropertyGroup>
    <Exec Command="&quot;$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -products * -version [17.0,18.0) -property installationPath" IgnoreExitCode="true" ConsoleToMsBuild="true" Condition="'$(RoslynVsInstallRoot)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="RoslynVsInstallRoot" />
    </Exec>
    <Exec Command="&quot;$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -products * -property installationPath" ConsoleToMsBuild="true" Condition="'$(RoslynVsInstallRoot)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="RoslynVsInstallRoot" />
    </Exec>
    <PropertyGroup Condition="'$(RoslynVsInstallRoot)' != ''">
      <VsRoslynDir>$(RoslynVsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\VBCSharp\LanguageServices</VsRoslynDir>
      <VsPublicAssembliesDir>$(RoslynVsInstallRoot)\Common7\IDE\PublicAssemblies</VsPublicAssembliesDir>
    </PropertyGroup>
    <Error Condition="'$(RoslynVsInstallRoot)' == ''" Text="Could not locate the Visual Studio installation. Set the RoslynVsInstallRoot property explicitly." />
    <ItemGroup Condition="'$(RoslynVsInstallRoot)' != ''">
      <Reference Include="Microsoft.CodeAnalysis">
        <HintPath>$(VsRoslynDir)\Microsoft.CodeAnalysis.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.CodeAnalysis.CSharp">
        <HintPath>$(VsRoslynDir)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.CodeAnalysis.Workspaces">
        <HintPath>$(VsRoslynDir)\Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
        <HintPath>$(VsRoslynDir)\Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Collections.Immutable">
        <HintPath>$(VsPublicAssembliesDir)\System.Collections.Immutable.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.LanguageServices">
        <HintPath>$(VsRoslynDir)\Microsoft.VisualStudio.LanguageServices.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Pure Roslyn analysis assembly built from source; shipped inside the VSIX. -->
    <VSIXSourceItem Include="$(OutputPath)RPAWriter.Roslyn.dll" />
  </ItemGroup>
  <!--
    CreatePkgDef (VSSDK 18.x) is compiled against System.Reflection.Metadata 10.x. The
    System.Reflection.MetadataLoadContext 8.0 package drops 8.x copies of System.Reflection.Metadata,
    System.Collections.Immutable and System.Reflection.MetadataLoadContext into the output, and those
    copies end up in CreatePkgDef's referenced-assemblies list, shadowing the 10.x version and crashing
    with "TypeLoadException ... GetGenericInstantiation". Keep the 8.x copies in the output for the VSIX
    runtime, but exclude them from the CreatePkgDef reference set.
  -->
  <Target Name="ExcludeConflictingCreatePkgDefReferences" BeforeTargets="GeneratePkgDef">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'System.Reflection.Metadata' Or '%(Filename)' == 'System.Collections.Immutable' Or '%(Filename)' == 'System.Reflection.MetadataLoadContext'" />
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'System.Reflection.Metadata' Or '%(Filename)' == 'System.Collections.Immutable' Or '%(Filename)' == 'System.Reflection.MetadataLoadContext'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyWebView2LoaderToOutput" BeforeTargets="GetVsixSourceItems">
    <!-- The WebView2 NuGet package only drops the native loader under runtimes\ for this
         SDK-style net472 project. Copy the x64 loader next to the managed assemblies so the
         VSIX (and F5 debug) can find it. -->
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Ship prompt template files next to the extension assemblies and inside the VSIX. -->
    <Content Include="Prompts\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the activity library (empty WF activity snippets + PIX activity descriptors) inside the VSIX. -->
    <Content Include="ActivityLibrary\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the user documentation (index + per-tab docs) inside the VSIX under "Docs"
         so the Help chat mode can load it into the context pipeline. -->
    <Content Include="..\documentation\**\*">
      <Link>Docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Legal document: third-party notices shipped inside the VSIX. -->
    <Content Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="RPAWriter2Package.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <Generator>VsctGenerator</Generator>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="RpaConverter\" />
  </ItemGroup>
</Project>